rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // For simplicity, we are assuming anyone signed in is an admin for now.
    // In a real app, you'd have a roles collection.
    function isAdmin() {
      return isSignedIn();
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /voters/{voterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /elections/{electionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /offlineLocations/{locationId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /votes/{voteId} {
      allow read: if isSignedIn();
      // Users can only create votes. They cannot update or delete them.
      // A more robust rule would check if the user has already voted in this election.
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
