{
  "entities": {
    "Candidate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Candidate",
      "type": "object",
      "description": "Represents a candidate in an election.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Candidate's full name."
        },
        "party": {
          "type": "string",
          "description": "Candidate's political party."
        },
        "manifesto": {
            "type": "string",
            "description": "Candidate's manifesto."
        },
        "imageUrl": {
            "type": "string",
            "description": "URL for the candidate's photo."
        },
        "email": {
            "type": "string",
            "description": "Candidate's email address.",
            "format": "email"
        },
        "idImageUrl": {
            "type": "string",
            "description": "URL for the candidate's ID photo."
        }
      },
      "required": [
        "name",
        "party",
        "manifesto",
        "imageUrl",
        "email",
        "idImageUrl"
      ]
    },
    "Voter": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Voter",
      "type": "object",
      "description": "Represents a registered voter in the Xhunav E-Vote system.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Voter's name."
        },
        "voterId": {
          "type": "string",
          "description": "Unique Voter ID."
        },
        "email": {
          "type": "string",
          "description": "Voter's email address.",
          "format": "email"
        },
        "idImageUrl": {
            "type": "string",
            "description": "URL for the voter's ID photo."
        }
      },
      "required": [
        "name",
        "voterId",
        "email",
        "idImageUrl"
      ]
    },
    "Election": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Election",
      "type": "object",
      "description": "Represents an election event.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the election."
        },
        "region": {
            "type": "string",
            "description": "Region of the election."
        },
        "startDate": {
          "type": "string",
          "description": "Date when the election starts."
        },
        "endDate": {
          "type": "string",
          "description": "Date when the election ends."
        },
        "status": {
            "type": "string",
            "enum": ["Upcoming", "Active", "Ended"]
        },
        "voterCount": {
            "type": "number",
            "description": "Number of voters in the election."
        },
        "candidateCount": {
            "type": "number",
            "description": "Number of candidates in the election."
        }
      },
      "required": [
        "name",
        "region",
        "startDate",
        "endDate",
        "status",
        "voterCount",
        "candidateCount"
      ]
    },
    "OfflineLocation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "OfflineLocation",
      "type": "object",
      "description": "Represents an offline polling location.",
      "properties": {
        "name": {
            "type": "string",
            "description": "Name of the location."
        },
        "region": {
            "type": "string",
            "description": "Region of the location."
        },
        "officer": {
            "type": "string",
            "description": "Assigned officer."
        },
        "deviceStatus": {
            "type": "string",
            "enum": ["Online", "Offline", "Syncing"]
        }
      },
      "required": [
          "name",
          "region",
          "officer",
          "deviceStatus"
      ]
    },
    "Vote": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vote",
      "type": "object",
      "description": "Represents a single vote cast in an election.",
      "properties": {
        "voterId": {
          "type": "string",
          "description": "Anonymized or Tokenized ID of the voter."
        },
        "electionId": {
          "type": "string",
          "description": "Reference to the Election."
        },
        "candidateId": {
          "type": "string",
          "description": "Reference to the Candidate."
        },
        "voteHash": {
          "type": "string",
          "description": "SHA-256 hash of the vote data."
        },
        "signature": {
          "type": "string",
          "description": "CRYSTALS-Dilithium signature of the vote hash."
        },
        "timestamp": {
          "type": "number",
          "description": "The time the vote was cast."
        }
      },
      "required": [
        "voterId",
        "electionId",
        "candidateId",
        "voteHash",
        "signature",
        "timestamp"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/candidates/{candidateId}",
        "definition": {
          "entityName": "Candidate",
          "schema": {
            "$ref": "#/entities/Candidate"
          },
          "description": "Stores candidate information."
        }
      },
      {
        "path": "/voters/{voterId}",
        "definition": {
          "entityName": "Voter",
          "schema": {
            "$ref": "#/entities/Voter"
          },
          "description": "Stores voter information."
        }
      },
      {
        "path": "/elections/{electionId}",
        "definition": {
          "entityName": "Election",
          "schema": {
            "$ref": "#/entities/Election"
          },
          "description": "Stores election information."
        }
      },
      {
        "path": "/offlineLocations/{locationId}",
        "definition": {
          "entityName": "OfflineLocation",
          "schema": {
            "$ref": "#/entities/OfflineLocation"
          },
          "description": "Stores offline polling station information."
        }
      },
      {
        "path": "/votes/{voteId}",
        "definition": {
          "entityName": "Vote",
          "schema": {
            "$ref": "#/entities/Vote"
          },
          "description": "Stores individual vote information."
        }
      }
    ]
  }
}
